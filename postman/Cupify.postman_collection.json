{
  "info": {
    "name": "Cupify",
    "description": "Tester för Cupify REST API. Kör mappen Tournaments i ordning (Run folder). Byt baseUrl under Variables för att testa mot en annan deploy.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://gk6k67x287.execute-api.eu-north-1.amazonaws.com" },
    { "key": "tournamentId", "value": "" },
    { "key": "emptyTournamentId", "value": "" }
  ],
  "item": [
    {
      "name": "Tournaments",
      "item": [
        {
          "name": "1. Skapa turnering",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Har id och status upcoming\", () => {",
                  "  const t = pm.response.json();",
                  "  pm.expect(t.id).to.be.a(\"string\");",
                  "  pm.expect(t.status).to.eql(\"upcoming\");",
                  "});",
                  "pm.collectionVariables.set(\"tournamentId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Höstcupen\",\n  \"sport\": \"fotboll\",\n  \"location\": \"Linköping\",\n  \"startDate\": \"2026-12-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/tournaments", "host": ["{{baseUrl}}"], "path": ["tournaments"] }
          }
        },
        {
          "name": "2. Hämta alla turneringar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Svaret är en lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/tournaments", "host": ["{{baseUrl}}"], "path": ["tournaments"] }
          }
        },
        {
          "name": "3. Hämta en turnering",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Rätt turnering\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"tournamentId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/tournaments/{{tournamentId}}", "host": ["{{baseUrl}}"], "path": ["tournaments", "{{tournamentId}}"] }
          }
        },
        {
          "name": "4. Uppdatera status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status är ongoing\", () => pm.expect(pm.response.json().status).to.eql(\"ongoing\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ \"status\": \"ongoing\" }",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/tournaments/{{tournamentId}}/status", "host": ["{{baseUrl}}"], "path": ["tournaments", "{{tournamentId}}", "status"] }
          }
        },
        {
          "name": "5. Uppdatera status – ogiltig",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status 400\", () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ \"status\": \"banan\" }",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/tournaments/{{tournamentId}}/status", "host": ["{{baseUrl}}"], "path": ["tournaments", "{{tournamentId}}", "status"] }
          }
        },
        {
          "name": "6. Hämta turnering – finns inte",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status 404\", () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/tournaments/finns-inte", "host": ["{{baseUrl}}"], "path": ["tournaments", "finns-inte"] }
          }
        },
        {
          "name": "7. Skapa turnering – tom body",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status 400\", () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/tournaments", "host": ["{{baseUrl}}"], "path": ["tournaments"] }
          }
        },
        {
          "name": "8. Skapa lag i turneringen",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status 201\", () => pm.response.to.have.status(201));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AIK\",\n  \"city\": \"Stockholm\",\n  \"coach\": \"Okänd\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/tournaments/{{tournamentId}}/teams", "host": ["{{baseUrl}}"], "path": ["tournaments", "{{tournamentId}}", "teams"] }
          }
        },
        {
          "name": "9. Radera turnering med lag",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status 409\", () => pm.response.to.have.status(409));"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/tournaments/{{tournamentId}}", "host": ["{{baseUrl}}"], "path": ["tournaments", "{{tournamentId}}"] }
          }
        },
        {
          "name": "10. Skapa tom turnering",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"emptyTournamentId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vintercupen\",\n  \"sport\": \"innebandy\",\n  \"location\": \"Linköping\",\n  \"startDate\": \"2027-01-15\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/tournaments", "host": ["{{baseUrl}}"], "path": ["tournaments"] }
          }
        },
        {
          "name": "11. Radera tom turnering",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status 204\", () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/tournaments/{{emptyTournamentId}}", "host": ["{{baseUrl}}"], "path": ["tournaments", "{{emptyTournamentId}}"] }
          }
        },
        {
          "name": "12. Hämta raderad turnering",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status 404\", () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/tournaments/{{emptyTournamentId}}", "host": ["{{baseUrl}}"], "path": ["tournaments", "{{emptyTournamentId}}"] }
          }
        }
      ]
    }
  ]
}
